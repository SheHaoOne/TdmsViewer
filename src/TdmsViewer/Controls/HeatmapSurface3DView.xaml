<UserControl x:Class="TdmsViewer.Controls.HeatmapSurface3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF5F5F7"
             ClipToBounds="True">
    <Grid>
        <Viewport3D x:Name="Viewport">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera"
                                   Position="1.35,-1.05,1.35"
                                   LookDirection="-1,0.75,-1"
                                   UpDirection="0,1,0"
                                   FieldOfView="42"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <DirectionalLight Color="White" Direction="-0.4,-1,-0.6"/>
                        <DirectionalLight Color="#FFCCCCCC" Direction="0.6,0.2,0.8"/>
                        <ModelVisual3D x:Name="SurfaceHost"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
        <TextBlock Text="拖拽旋转 · 滚轮缩放"
                   Style="{StaticResource MacSecondaryStyle}"
                   Margin="10"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
