<UserControl x:Class="TdmsViewer.Controls.HeatmapChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:controls="clr-namespace:TdmsViewer.Controls"
             xmlns:conv="clr-namespace:TdmsViewer.Converters"
             MinHeight="320"
             Margin="0">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
    </UserControl.Resources>
    <Border Style="{StaticResource MacCardStyle}" Padding="16" Margin="0">
        <Grid DataContext="{Binding ViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource MacCaptionStyle}"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="视图"
                               Style="{StaticResource MacSecondaryStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <RadioButton Content="二维"
                                 GroupName="HeatmapViewMode"
                                 IsChecked="{Binding Is2DView, Mode=TwoWay}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                    <RadioButton Content="三维"
                                 GroupName="HeatmapViewMode"
                                 IsChecked="{Binding Is3DView, Mode=TwoWay}"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          Style="{StaticResource MacCheckBoxStyle}"
                          Content="自动色阶"
                          IsChecked="{Binding UseAutoColorRange, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="下限"
                           Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBox Grid.Column="2"
                         Text="{Binding ColorMinText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding UseAutoColorRange}"
                         Margin="0,0,12,0"/>
                <TextBlock Grid.Column="3"
                           Text="上限"
                           Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBox Grid.Column="4"
                         Text="{Binding ColorMaxText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding UseAutoColorRange}"
                         Margin="0,0,12,0"/>
                <Button Grid.Column="5"
                        Content="重置"
                        Style="{StaticResource MacToolbarButtonStyle}"
                        Command="{Binding ResetColorRangeCommand}"
                        Padding="10,4"/>
            </Grid>
            <TextBlock Grid.Row="2"
                       Text="{Binding ColorRangeSummary}"
                       Style="{StaticResource MacSecondaryStyle}"
                       Margin="0,0,0,4"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Row="3"
                       Text="提示：在右侧色条上下边缘拖拽可调整色阶上下限。"
                       Style="{StaticResource MacSecondaryStyle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Visibility="{Binding Is2DView, Converter={StaticResource BoolVis}}"/>
            <TextBlock Grid.Row="4"
                       Text="三维视图（ECharts）：拖拽旋转视角，滚轮缩放；色阶与二维视图同步。"
                       Style="{StaticResource MacSecondaryStyle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Visibility="{Binding Is3DView, Converter={StaticResource BoolVis}}"/>
            <Border Grid.Row="5"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <ScottPlot:WpfPlot x:Name="PlotHost"
                                       Visibility="{Binding Is2DView, Converter={StaticResource BoolVis}}"/>
                    <controls:HeatmapECharts3DView x:Name="SurfaceHost"
                                                   Visibility="{Binding Is3DView, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
