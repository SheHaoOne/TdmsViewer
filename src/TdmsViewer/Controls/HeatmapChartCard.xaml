<UserControl x:Class="TdmsViewer.Controls.HeatmapChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:controls="clr-namespace:TdmsViewer.Controls"
             xmlns:conv="clr-namespace:TdmsViewer.Converters"
             MinHeight="320"
             Margin="0"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
    </UserControl.Resources>
    <Border x:Name="CardBorder" Style="{StaticResource MacCardStyle}" Padding="16" Margin="0">
        <Grid DataContext="{Binding ViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ChartRow" Height="280"/>
            </Grid.RowDefinitions>
            <Grid x:Name="TitleRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource MacCaptionStyle}"
                           VerticalAlignment="Center"/>
                <controls:ChartFullscreenIconButton Grid.Column="1"
                                                    Click="FullscreenButton_Click"/>
            </Grid>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Text="视图"
                           Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <RadioButton Content="二维"
                             GroupName="HeatmapViewMode"
                             IsChecked="{Binding Is2DView, Mode=TwoWay}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                <RadioButton Content="三维"
                             GroupName="HeatmapViewMode"
                             IsChecked="{Binding Is3DView, Mode=TwoWay}"
                             VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          Style="{StaticResource MacCheckBoxStyle}"
                          Content="自动色阶"
                          IsChecked="{Binding UseAutoColorRange, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="下限"
                           Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBox Grid.Column="2"
                         Text="{Binding ColorMinText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding UseAutoColorRange}"
                         Margin="0,0,12,0"/>
                <TextBlock Grid.Column="3"
                           Text="上限"
                           Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBox Grid.Column="4"
                         Text="{Binding ColorMaxText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding UseAutoColorRange}"
                         Margin="0,0,12,0"/>
                <Button Grid.Column="5"
                        Content="重置"
                        Style="{StaticResource MacToolbarButtonStyle}"
                        Command="{Binding ResetColorRangeCommand}"
                        Padding="10,4"/>
            </Grid>
            <TextBlock Grid.Row="3"
                       Text="{Binding ColorRangeSummary}"
                       Style="{StaticResource MacSecondaryStyle}"
                       Margin="0,0,0,4"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Row="4"
                       Text="提示：在右侧色条上下边缘拖拽可调整色阶上下限。"
                       Style="{StaticResource MacSecondaryStyle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Visibility="{Binding Is2DView, Converter={StaticResource BoolVis}}"/>
            <TextBlock Grid.Row="5"
                       Text="三维视图（ECharts）：拖拽旋转视角，滚轮缩放；色阶与二维视图同步。"
                       Style="{StaticResource MacSecondaryStyle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Visibility="{Binding Is3DView, Converter={StaticResource BoolVis}}"/>
            <Border Grid.Row="6"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <ScottPlot:WpfPlot x:Name="PlotHost"
                                       Visibility="{Binding Is2DView, Converter={StaticResource BoolVis}}"/>
                    <controls:HeatmapECharts3DView x:Name="SurfaceHost"
                                                   Visibility="{Binding Is3DView, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
