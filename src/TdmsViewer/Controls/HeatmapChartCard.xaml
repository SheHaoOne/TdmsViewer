<UserControl x:Class="TdmsViewer.Controls.HeatmapChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinHeight="320"
             Margin="0">
    <Border Style="{StaticResource MacCardStyle}" Padding="16" Margin="0">
        <Grid DataContext="{Binding ViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource MacCaptionStyle}"
                       Margin="0,0,0,8"/>
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          Style="{StaticResource MacCheckBoxStyle}"
                          Content="自动色阶"
                          IsChecked="{Binding UseAutoColorRange, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="下限"
                           Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBox Grid.Column="2"
                         Text="{Binding ColorMinText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding UseAutoColorRange}"
                         Margin="0,0,12,0"/>
                <TextBlock Grid.Column="3"
                           Text="上限"
                           Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBox Grid.Column="4"
                         Text="{Binding ColorMaxText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding UseAutoColorRange}"
                         Margin="0,0,12,0"/>
                <Button Grid.Column="5"
                        Content="重置"
                        Style="{StaticResource MacToolbarButtonStyle}"
                        Command="{Binding ResetColorRangeCommand}"
                        Padding="10,4"/>
            </Grid>
            <TextBlock Grid.Row="2"
                       Text="{Binding ColorRangeSummary}"
                       Style="{StaticResource MacSecondaryStyle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
            <Border Grid.Row="3"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ScottPlot:WpfPlot x:Name="PlotHost"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
