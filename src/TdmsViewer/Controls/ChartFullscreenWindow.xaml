<Window x:Class="TdmsViewer.Controls.ChartFullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TdmsViewer.Controls"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource MacWindowBgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="Window_KeyDown">
    <Grid>
        <ContentPresenter x:Name="Host" Margin="16"/>
        <controls:ChartExitFullscreenIconButton HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,20,20,0"
                                                Panel.ZIndex="1"
                                                Click="ExitButton_Click"/>
    </Grid>
</Window>
