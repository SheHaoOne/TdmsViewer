<UserControl x:Class="TdmsViewer.Controls.LineChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinHeight="280"
             Margin="0">
    <Border Style="{StaticResource MacCardStyle}" Padding="16" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource MacCaptionStyle}"
                       Margin="0,0,0,8"/>
            <Border Grid.Row="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ScottPlot:WpfPlot x:Name="PlotHost"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
