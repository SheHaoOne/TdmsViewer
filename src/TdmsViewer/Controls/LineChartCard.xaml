<UserControl x:Class="TdmsViewer.Controls.LineChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinHeight="280"
             Margin="0">
    <Border Style="{StaticResource MacCardStyle}" Padding="16" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ChartRow" Height="280"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource MacCaptionStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="全屏"
                        Style="{StaticResource MacToolbarButtonStyle}"
                        Padding="10,4"
                        Margin="0"
                        Click="FullscreenButton_Click"
                        ToolTip="全屏查看"/>
            </Grid>
            <Border Grid.Row="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ScottPlot:WpfPlot x:Name="PlotHost"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
