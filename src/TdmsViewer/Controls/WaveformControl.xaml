<UserControl x:Class="TdmsViewer.Controls.WaveformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinHeight="0"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Border Style="{StaticResource MacCardStyle}" Padding="16" VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="波形图"
                       Style="{StaticResource MacCaptionStyle}"
                       Margin="0,0,0,8"/>
            <Border Grid.Row="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ScottPlot:WpfPlot x:Name="WpfPlot"/>
            </Border>
            <TextBlock x:Name="EmptyHint"
                       Grid.Row="1"
                       Text="暂无波形数据"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MacTextSecondaryBrush}"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
