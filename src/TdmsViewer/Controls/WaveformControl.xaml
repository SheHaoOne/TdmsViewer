<UserControl x:Class="TdmsViewer.Controls.WaveformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:TdmsViewer.Models"
             MinHeight="200">
    <Grid>
        <Border Style="{StaticResource MacCardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="波形图"
                           Style="{StaticResource MacCaptionStyle}"
                           Margin="0,0,0,8"/>
                <Border Grid.Row="1"
                        Background="{StaticResource MacSurfaceSecondaryBrush}"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Canvas x:Name="PlotCanvas"
                            Background="Transparent"
                            SizeChanged="PlotCanvas_SizeChanged"/>
                </Border>
                <TextBlock x:Name="EmptyHint"
                           Grid.Row="1"
                           Text="暂无波形数据"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MacTextSecondaryBrush}"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
