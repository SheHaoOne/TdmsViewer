<UserControl x:Class="TdmsViewer.Dashboard.Controls.DashboardWebView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource MacWindowBgBrush}">
    <Grid>
        <wv2:WebView2 x:Name="WebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <TextBlock x:Name="PlaceholderText"
                   Text="正在加载分析大屏…"
                   Style="{StaticResource MacSecondaryStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
