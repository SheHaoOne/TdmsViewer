<Window x:Class="TdmsViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TdmsViewer.Controls"
        xmlns:conv="clr-namespace:TdmsViewer.Converters"
        xmlns:models="clr-namespace:TdmsViewer.Models"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>

        <DataTemplate x:Key="PropertyCardTemplate" DataType="{x:Type models:ChannelPropertyCard}">
            <Border Style="{StaticResource MacCardStyle}" Padding="14" MinWidth="160" MaxWidth="280" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding Key}"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Value}"
                               Style="{StaticResource MacBodyStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChannelItemTemplate" DataType="{x:Type models:TdmsChannelInfo}">
            <StackPanel>
                <TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding GroupName}" Style="{StaticResource MacSecondaryStyle}" Margin="0,2,0,0"/>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MacSecondaryStyle}">
                    <Run Text="{Binding SampleCount, StringFormat={}{0:N0}}"/>
                    <Run Text=" 点 · "/>
                    <Run Text="{Binding DataTypeName}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F2FFFFFF" BorderBrush="{StaticResource MacSeparatorBrush}" BorderThickness="0,0,0,0.5" Padding="16,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="打开" Style="{StaticResource MacPrimaryButtonStyle}" Command="{Binding OpenFileCommand}"/>
                    <Button Content="导入" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ImportFileCommand}"/>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource MacSeparatorBrush}" Margin="4,0,12,0"/>
                    <Button Content="播放音频" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding PlayAudioCommand}"/>
                    <Button Content="停止" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding StopAudioCommand}"/>
                    <Button Content="导出 WAV" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ExportAudioCommand}"/>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource MacSeparatorBrush}" Margin="4,0,12,0"/>
                    <Button Content="关联 .tdms" Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding RegisterFileAssociationCommand}"
                            Visibility="{Binding IsFileAssociationRegistered, Converter={StaticResource BoolVisInvert}}"/>
                    <Button Content="取消关联" Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding UnregisterFileAssociationCommand}"
                            Visibility="{Binding IsFileAssociationRegistered, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentFilePath, TargetNullValue=未打开文件}"
                           TextTrimming="CharacterEllipsis" MaxWidth="400"/>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Channel list -->
            <Border Grid.Column="0" Style="{StaticResource MacCardStyle}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="通道" Style="{StaticResource MacCaptionStyle}" Margin="8,8,8,12"/>
                    <ListBox ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                             ItemTemplate="{StaticResource ChannelItemTemplate}"
                             ItemContainerStyle="{StaticResource MacListBoxItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"/>
                </DockPanel>
            </Border>

            <!-- Detail panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Property cards -->
                    <TextBlock Text="通道属性" Style="{StaticResource MacCaptionStyle}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding PropertyCards}"
                                  ItemTemplate="{StaticResource PropertyCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <controls:WaveformControl Margin="0,20,0,0" Points="{Binding WaveformPoints}" MinHeight="240"/>

                    <!-- Data table -->
                    <Border Style="{StaticResource MacCardStyle}" Margin="0,20,0,0" Padding="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,16,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通道数据" Style="{StaticResource MacCaptionStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="首页" Style="{StaticResource MacToolbarButtonStyle}" Padding="10,6" Command="{Binding FirstPageCommand}"/>
                                    <Button Content="上一页" Style="{StaticResource MacToolbarButtonStyle}" Padding="10,6" Command="{Binding PreviousPageCommand}"/>
                                    <TextBlock VerticalAlignment="Center" Margin="8,0"
                                               Text="{Binding PageInfo}" Style="{StaticResource MacSecondaryStyle}"/>
                                    <Button Content="下一页" Style="{StaticResource MacToolbarButtonStyle}" Padding="10,6" Command="{Binding NextPageCommand}"/>
                                    <Button Content="末页" Style="{StaticResource MacToolbarButtonStyle}" Padding="10,6" Command="{Binding LastPageCommand}"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding PageRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      Margin="8,0,8,16"
                                      MaxHeight="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="索引" Binding="{Binding Index}" Width="120"/>
                                    <DataGridTextColumn Header="数值" Binding="{Binding FormattedValue}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#F2FFFFFF" BorderBrush="{StaticResource MacSeparatorBrush}" BorderThickness="0,0.5,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MacSecondaryStyle}"/>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                             Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Empty state overlay -->
        <Border Grid.Row="1" Grid.RowSpan="1"
                Background="#CCF5F5F7"
                Visibility="{Binding HasFile, Converter={StaticResource BoolVisInvert}}"
                Margin="16">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="TdmsViewer" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock Text="打开、导入或拖放 .tdms 文件开始查看" Style="{StaticResource MacSecondaryStyle}"
                           Margin="0,12,0,24" HorizontalAlignment="Center"/>
                <Button Content="打开 TDMS 文件" Style="{StaticResource MacPrimaryButtonStyle}"
                        Command="{Binding OpenFileCommand}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
