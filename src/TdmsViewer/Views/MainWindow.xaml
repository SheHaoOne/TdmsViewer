<Window x:Class="TdmsViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TdmsViewer.Controls"
        xmlns:conv="clr-namespace:TdmsViewer.Converters"
        xmlns:models="clr-namespace:TdmsViewer.Models"
        xmlns:vm="clr-namespace:TdmsViewer.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1320" Height="820"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>

        <Style x:Key="FileNameLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MacAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PropertyCardTemplate" DataType="{x:Type models:ChannelPropertyCard}">
            <Border Style="{StaticResource MacCardStyle}" Padding="14" MinWidth="160" MaxWidth="280" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding Key}"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Value}"
                               Style="{StaticResource MacBodyStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MergedChannelTemplate" DataType="{x:Type models:MergedChannelInfo}">
            <StackPanel>
                <TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding GroupName}" Style="{StaticResource MacSecondaryStyle}" Margin="0,2,0,0"/>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MacSecondaryStyle}">
                    <Run Text="{Binding SourceCount, Mode=OneWay}"/>
                    <Run Text=" 个文件可叠加"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileListItemTemplate" DataType="{x:Type vm:TdmsFileListItem}">
            <Border Padding="8,6" CornerRadius="8" Margin="0,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectedForData}" Value="True">
                                <Setter Property="Background" Value="#FFE8E8ED"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsVisibleOnPlot, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              ToolTip="参与波形叠加"/>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="3" CornerRadius="1.5"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{Binding PlotColor, Converter={StaticResource HexToBrush}}"
                                    ToolTip="波形线条颜色"/>
                            <Button Style="{StaticResource FileNameLinkButtonStyle}"
                                    Content="{Binding FileName}"
                                    Command="{Binding DataContext.SelectFileForDataCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MacSecondaryStyle}" Margin="0,2,0,0">
                            <Run Text="{Binding ChannelCount, Mode=OneWay}"/>
                            <Run Text=" 个通道"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Content="×" Padding="6,2" Margin="4,0,0,0"
                            Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="移除此文件"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F2FFFFFF" BorderBrush="{StaticResource MacSeparatorBrush}" BorderThickness="0,0,0,0.5" Padding="16,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="批量导入" Style="{StaticResource MacPrimaryButtonStyle}" Command="{Binding BatchImportCommand}"/>
                    <Button Content="清空" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ClearFilesCommand}"/>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource MacSeparatorBrush}" Margin="4,0,12,0"/>
                    <Button Content="播放音频" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding PlayAudioCommand}"/>
                    <Button Content="停止" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding StopAudioCommand}"/>
                    <Button Content="导出 WAV" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ExportAudioCommand}"/>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource MacSeparatorBrush}" Margin="4,0,12,0"/>
                    <Button Content="关联 .tdms" Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding RegisterFileAssociationCommand}"
                            Visibility="{Binding IsFileAssociationRegistered, Converter={StaticResource BoolVisInvert}}"/>
                    <Button Content="取消关联" Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding UnregisterFileAssociationCommand}"
                            Visibility="{Binding IsFileAssociationRegistered, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Text="{Binding SessionSummary, TargetNullValue=未导入文件}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: files + channels, each 50% height -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource MacCardStyle}" Padding="8" Margin="0,0,0,6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="8,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="已导入文件" Style="{StaticResource MacCaptionStyle}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      Content="全选"
                                      IsChecked="{Binding IsAllFilesOverlayChecked, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      ToolTip="勾选：全部参与波形叠加；取消：全部不叠加"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding LoadedFiles}"
                                 ItemTemplate="{StaticResource FileListItemTemplate}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource MacCardStyle}" Padding="8" Margin="0,6,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="通道（同名叠加，不限组）" Style="{StaticResource MacCaptionStyle}" Margin="8,8,8,12"/>
                        <ListBox ItemsSource="{Binding MergedChannels}"
                                 SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource MergedChannelTemplate}"
                                 ItemContainerStyle="{StaticResource MacListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Detail panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="通道属性" Style="{StaticResource MacCaptionStyle}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding PropertyCards}"
                                  ItemTemplate="{StaticResource PropertyCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Waveform (left) + Data (right) -->
                    <Grid Margin="0,20,0,0" MinHeight="400">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="280" MaxWidth="520"/>
                        </Grid.ColumnDefinitions>

                        <controls:WaveformControl Grid.Column="0"
                                                  Series="{Binding WaveformSeries}"
                                                  MinHeight="400"
                                                  VerticalAlignment="Stretch"/>

                        <Border Grid.Column="2"
                                Style="{StaticResource MacCardStyle}"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="280">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="通道数据" Style="{StaticResource MacCaptionStyle}"/>
                                        <TextBlock Margin="8,0,0,0" Style="{StaticResource MacSecondaryStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200">
                                            <Run Text="— "/>
                                            <Run Text="{Binding ActiveFile.FileName, Mode=OneWay, TargetNullValue='未选择'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <WrapPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <Button Content="首页" Style="{StaticResource MacToolbarButtonStyle}" Padding="8,5" Margin="0,0,4,0" Command="{Binding FirstPageCommand}"/>
                                        <Button Content="上页" Style="{StaticResource MacToolbarButtonStyle}" Padding="8,5" Margin="0,0,4,0" Command="{Binding PreviousPageCommand}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="4,0"
                                                   Text="{Binding PageInfo}" Style="{StaticResource MacSecondaryStyle}"/>
                                        <Button Content="下页" Style="{StaticResource MacToolbarButtonStyle}" Padding="8,5" Margin="4,0,4,0" Command="{Binding NextPageCommand}"/>
                                        <Button Content="末页" Style="{StaticResource MacToolbarButtonStyle}" Padding="8,5" Command="{Binding LastPageCommand}"/>
                                    </WrapPanel>
                                </Grid>

                                <DataGrid ItemsSource="{Binding PageRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Single"
                                          Margin="8,0,8,12"
                                          MinHeight="320"
                                          MaxHeight="520"
                                          HorizontalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="索引" Binding="{Binding Index}" Width="Auto"/>
                                        <DataGridTextColumn Header="数值" Binding="{Binding FormattedValue}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MacSecondaryStyle}"
                               Text="勾选文件参与波形叠加；单击文件名查看属性与数据；色条与波形颜色一致"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#F2FFFFFF" BorderBrush="{StaticResource MacSeparatorBrush}" BorderThickness="0,0.5,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MacSecondaryStyle}"/>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                             Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="1"
                Background="#CCF5F5F7"
                Visibility="{Binding HasFile, Converter={StaticResource BoolVisInvert}}"
                Margin="16">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="TdmsViewer" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock Text="批量导入多个 TDMS 文件，勾选文件叠加波形，单击文件名查看数据"
                           Style="{StaticResource MacSecondaryStyle}"
                           Margin="0,12,0,24" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="批量导入 TDMS 文件" Style="{StaticResource MacPrimaryButtonStyle}"
                        Command="{Binding BatchImportCommand}" HorizontalAlignment="Center"/>
                <TextBlock Text="也可将多个 .tdms 文件拖入窗口（追加导入）"
                           Style="{StaticResource MacSecondaryStyle}"
                           Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
