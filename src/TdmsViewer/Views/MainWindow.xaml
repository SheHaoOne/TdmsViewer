<Window x:Class="TdmsViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TdmsViewer.Controls"
        xmlns:conv="clr-namespace:TdmsViewer.Converters"
        xmlns:models="clr-namespace:TdmsViewer.Models"
        xmlns:views="clr-namespace:TdmsViewer.Views"
        xmlns:vm="clr-namespace:TdmsViewer.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app-icon.png"
        Width="1320" Height="820"
        MinWidth="1000" MinHeight="640"
        WindowState="Maximized"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:HeightFractionConverter x:Key="HeightFraction"/>
        <conv:AppViewModeToVisibilityConverter x:Key="ViewModeViewer" TargetMode="Viewer"/>
        <conv:AppViewModeToVisibilityConverter x:Key="ViewModeAnalysis" TargetMode="Analysis"/>
        <conv:AppViewModeToVisibilityConverter x:Key="ViewModeReport" TargetMode="Report"/>

        <DataTemplate x:Key="PropertyCardTemplate" DataType="{x:Type models:ChannelPropertyCard}">
            <Border Style="{StaticResource MacCardStyle}" Padding="14" MinWidth="160" MaxWidth="280" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding Key}"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Value}"
                               Style="{StaticResource MacBodyStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GroupListItemTemplate" DataType="{x:Type models:TdmsGroupInfo}">
            <StackPanel>
                <TextBlock Text="{Binding GroupName}" Style="{StaticResource MacListPrimaryTextStyle}"/>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MacListMetaTextStyle}">
                    <Run Text="{Binding ChannelCount, Mode=OneWay}"/>
                    <Run Text=" 个通道"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MergedChannelTemplate" DataType="{x:Type models:MergedChannelInfo}">
            <StackPanel>
                <TextBlock Text="{Binding ChannelName}" Style="{StaticResource MacListPrimaryTextStyle}"/>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MacListMetaTextStyle}">
                    <Run Text="{Binding SourceCount, Mode=OneWay}"/>
                    <Run Text=" 个文件可叠加"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileListItemTemplate" DataType="{x:Type vm:TdmsFileListItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          Style="{StaticResource MacCheckBoxStyle}"
                          IsChecked="{Binding IsVisibleOnPlot, Mode=TwoWay}"
                          VerticalAlignment="Top"
                          Margin="0,2,10,0"
                          ToolTip="参与波形叠加"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="24" Height="3" CornerRadius="1.5"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                Background="{Binding PlotColor, Converter={StaticResource HexToBrush}}"
                                ToolTip="波形线条颜色"/>
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource MacFileNameTextStyle}"/>
                    </StackPanel>
                    <TextBlock Margin="32,0,0,0" Style="{StaticResource MacFileMetaTextStyle}">
                        <Run Text="{Binding ChannelCount, Mode=OneWay}"/>
                        <Run Text=" 个通道"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="×"
                        Style="{StaticResource MacIconButtonStyle}"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        ToolTip="移除此文件"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F2FFFFFF" BorderBrush="{StaticResource MacSeparatorBrush}" BorderThickness="0,0,0,0.5" Padding="16,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource MacPrimaryButtonStyle}" Command="{Binding BatchImportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE8B5;"/>
                            <TextBlock Text="批量导入" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ClearFilesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE74D;"/>
                            <TextBlock Text="清空" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ShowViewerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE7B3;"/>
                            <TextBlock Text="数据预览" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource MacSeparatorBrush}" Margin="4,0,12,0"/>
                    <Button Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding PlayAudioCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE768;"/>
                            <TextBlock Text="播放音频" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding StopAudioCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE71A;"/>
                            <TextBlock Text="停止" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ExportAudioCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE896;"/>
                            <TextBlock Text="导出WAV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource MacSeparatorBrush}" Margin="4,0,12,0"/>
                    <Button Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding OpenAnalysisCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE9D9;"/>
                            <TextBlock Text="数据分析" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ShowReportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE9F9;"/>
                            <TextBlock Text="分析报表" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource MacSeparatorBrush}" Margin="4,0,12,0"/>
                    <Button Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding RegisterFileAssociationCommand}"
                            Visibility="{Binding IsFileAssociationRegistered, Converter={StaticResource BoolVisInvert}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE71B;"/>
                            <TextBlock Text="关联.tdms" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding UnregisterFileAssociationCommand}"
                            Visibility="{Binding IsFileAssociationRegistered, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MacToolbarIconGlyphStyle}" Text="&#xE71B;"/>
                            <TextBlock Text="取消关联" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MacSecondaryStyle}"
                           VerticalAlignment="Center"
                           Text="{Binding SessionSummary, TargetNullValue=未导入文件}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16"
              Visibility="{Binding CurrentViewMode, Converter={StaticResource ViewModeViewer}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: files + groups + channels -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource MacCardStyle}" Padding="8" Margin="0,0,0,4">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Margin="4,4,4,8"
                                Padding="8,8,8,10"
                                BorderBrush="{StaticResource MacSeparatorBrush}"
                                BorderThickness="0,0,0,0.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="已导入文件" Style="{StaticResource MacCaptionStyle}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource MacCheckBoxStyle}"
                                          Content="全选叠加"
                                          IsChecked="{Binding IsAllFilesOverlayChecked, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="勾选：全部参与波形叠加；取消：全部不叠加"/>
                            </Grid>
                        </Border>
                        <ListBox ItemsSource="{Binding LoadedFiles}"
                                 SelectedItem="{Binding ActiveFile, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource FileListItemTemplate}"
                                 ItemContainerStyle="{StaticResource MacFileListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource MacCardStyle}" Padding="8" Margin="0,4,0,4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="组" Style="{StaticResource MacCaptionStyle}" Margin="8,8,8,12"/>
                        <ListBox ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource GroupListItemTemplate}"
                                 ItemContainerStyle="{StaticResource MacFileListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource MacCardStyle}" Padding="8" Margin="0,4,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="通道" Style="{StaticResource MacCaptionStyle}" Margin="8,8,8,12"/>
                        <ListBox ItemsSource="{Binding MergedChannels}"
                                 SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource MergedChannelTemplate}"
                                 ItemContainerStyle="{StaticResource MacFileListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Detail panel -->
            <Grid x:Name="DetailPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 组属性：自适应高度，最高 1/4 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="组属性" Style="{StaticResource MacCaptionStyle}" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="{Binding ActualHeight, ElementName=DetailPanel, Converter={StaticResource HeightFraction}, ConverterParameter=0.25}">
                        <ItemsControl ItemsSource="{Binding GroupPropertyCards}"
                                      ItemTemplate="{StaticResource PropertyCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 通道属性：自适应高度，最高 1/4 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="通道属性" Style="{StaticResource MacCaptionStyle}" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="{Binding ActualHeight, ElementName=DetailPanel, Converter={StaticResource HeightFraction}, ConverterParameter=0.25}">
                        <ItemsControl ItemsSource="{Binding PropertyCards}"
                                      ItemTemplate="{StaticResource PropertyCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 波形图 + 通道数据：占满剩余高度 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="280" MaxWidth="520"/>
                        </Grid.ColumnDefinitions>

                        <controls:WaveformControl x:Name="MainWaveform"
                                                  Grid.Column="0"
                                                  Series="{Binding WaveformSeries}"
                                                  HighlightStartSec="{Binding Workbench.GlobalHighlightStartSec}"
                                                  HighlightEndSec="{Binding Workbench.GlobalHighlightEndSec}"
                                                  VerticalAlignment="Stretch"
                                                  HorizontalAlignment="Stretch"/>

                        <Border Grid.Column="2"
                                Style="{StaticResource MacCardStyle}"
                                Padding="0"
                                MinWidth="280"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="12,12,12,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="通道数据" Style="{StaticResource MacCaptionStyle}"/>
                                        <TextBlock Margin="8,0,0,0" Style="{StaticResource MacSecondaryStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200">
                                            <Run Text="— "/>
                                            <Run Text="{Binding ActiveFile.FileName, Mode=OneWay, TargetNullValue='未选择'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <WrapPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <Button Content="首页" Style="{StaticResource MacToolbarButtonStyle}" Padding="8,5" Margin="0,0,4,0" Command="{Binding FirstPageCommand}"/>
                                        <Button Content="上页" Style="{StaticResource MacToolbarButtonStyle}" Padding="8,5" Margin="0,0,4,0" Command="{Binding PreviousPageCommand}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="4,0"
                                                   Text="{Binding PageInfo}" Style="{StaticResource MacSecondaryStyle}"/>
                                        <Button Content="下页" Style="{StaticResource MacToolbarButtonStyle}" Padding="8,5" Margin="4,0,4,0" Command="{Binding NextPageCommand}"/>
                                        <Button Content="末页" Style="{StaticResource MacToolbarButtonStyle}" Padding="8,5" Command="{Binding LastPageCommand}"/>
                                    </WrapPanel>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding PageRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Single"
                                          Margin="8,0,8,12"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="索引" Binding="{Binding Index}" Width="Auto"/>
                                        <DataGridTextColumn Header="数值" Binding="{Binding FormattedValue}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,0"
                               Style="{StaticResource MacSecondaryStyle}"
                               Text="勾选文件参与波形叠加；未勾选时单击文件名显示该文件波形；色条与波形颜色一致"
                               TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="16"
              Visibility="{Binding CurrentViewMode, Converter={StaticResource ViewModeAnalysis}}">
            <views:AnalysisWorkbenchView DataContext="{Binding Workbench}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="16"
              Visibility="{Binding CurrentViewMode, Converter={StaticResource ViewModeReport}}">
            <views:AnalysisReportView DataContext="{Binding Report}"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#F2FFFFFF" BorderBrush="{StaticResource MacSeparatorBrush}" BorderThickness="0,0.5,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MacSecondaryStyle}"/>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                             Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="1"
                Background="#CCF5F5F7"
                Margin="16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasFile}" Value="False"/>
                                <Condition Binding="{Binding CurrentViewMode}" Value="{x:Static vm:AppViewMode.Viewer}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="TdmsViewer" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock Text="批量导入多个 TDMS 文件，勾选文件叠加波形，单击文件名查看数据"
                           Style="{StaticResource MacSecondaryStyle}"
                           Margin="0,12,0,24" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="批量导入 TDMS 文件" Style="{StaticResource MacPrimaryButtonStyle}"
                        Command="{Binding BatchImportCommand}" HorizontalAlignment="Center"/>
                <TextBlock Text="也可将多个 .tdms 文件拖入窗口（追加导入）"
                           Style="{StaticResource MacSecondaryStyle}"
                           Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
