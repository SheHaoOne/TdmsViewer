<UserControl x:Class="TdmsViewer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="clr-namespace:TdmsViewer.Dashboard.Controls"
             xmlns:vm="clr-namespace:TdmsViewer.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource MacCardStyle}" Margin="0,0,0,12" Padding="14,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="分析大屏" Style="{StaticResource MacCaptionStyle}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MacSecondaryStyle}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="清空历史"
                            Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding ClearAllReportsCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="导出 HTML"
                            Style="{StaticResource MacToolbarButtonStyle}"
                            Command="{Binding ExportHtmlCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MacCardStyle}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="报表历史" Style="{StaticResource MacCaptionStyle}" Margin="8,8,8,12"/>
                    <ListBox ItemsSource="{Binding ReportHistory}"
                             SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportHistoryItem}">
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource MacBodyStyle}"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                               Style="{StaticResource MacSecondaryStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MacCardStyle}" Padding="0">
                <dashboard:DashboardWebView Report="{Binding CurrentReport}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
