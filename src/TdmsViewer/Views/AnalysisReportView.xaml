<UserControl x:Class="TdmsViewer.Views.AnalysisReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TdmsViewer.Controls"
             xmlns:reporting="clr-namespace:TdmsViewer.Analysis.Reporting">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
        <StackPanel>
            <Border Style="{StaticResource MacCardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Meta.Title, TargetNullValue=分析报告}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MacSecondaryStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type reporting:LineChartModel}">
                        <controls:LineChartCard Model="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type reporting:BarChartModel}">
                        <controls:BarChartCard Model="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
