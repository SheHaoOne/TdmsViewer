<UserControl x:Class="TdmsViewer.Views.AnalysisReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TdmsViewer.Controls"
             xmlns:conv="clr-namespace:TdmsViewer.Converters"
             xmlns:vm="clr-namespace:TdmsViewer.ViewModels">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <DataTemplate x:Key="LineChartCardTemplate">
            <Border Margin="10">
                <controls:LineChartCard Model="{Binding}"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BarChartCardTemplate">
            <Border Margin="10">
                <controls:BarChartCard Model="{Binding}"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HeatmapChartCardTemplate">
            <Border Margin="10">
                <controls:HeatmapChartCard ViewModel="{Binding}"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="MetricCardTemplate">
            <Border Margin="10">
                <controls:MetricCard DataContext="{Binding}"/>
            </Border>
        </DataTemplate>
        <controls:ChartCardTemplateSelector x:Key="ChartCardTemplateSelector"
                                            LineChartTemplate="{StaticResource LineChartCardTemplate}"
                                            BarChartTemplate="{StaticResource BarChartCardTemplate}"
                                            HeatmapChartTemplate="{StaticResource HeatmapChartCardTemplate}"
                                            MetricCardTemplate="{StaticResource MetricCardTemplate}"/>
    </UserControl.Resources>
    <ScrollViewer x:Name="ReportScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  Padding="0,8,0,0"
                  PreviewMouseWheel="ReportScrollViewer_PreviewMouseWheel">
        <StackPanel>
            <Border Style="{StaticResource MacCardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Meta.Title, TargetNullValue='分析报告'}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MacSecondaryStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MacCardStyle}"
                    Padding="16"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasOverlayControls, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图表叠加"
                                   Style="{StaticResource MacCaptionStyle}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource MacCheckBoxStyle}"
                                  Content="全选"
                                  IsChecked="{Binding IsAllOverlayChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip="勾选要在图表中显示的文件"/>
                    </Grid>
                    <TextBlock Text="分析完成后，勾选需要显示在图表中的文件"
                               Style="{StaticResource MacSecondaryStyle}"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding OverlayFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportOverlayFileItem}">
                                <Grid Margin="0,0,24,8" MinWidth="220">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource MacCheckBoxStyle}"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              ToolTip="显示在图表中"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24" Height="3"
                                                CornerRadius="1.5"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Background="{Binding PlotColor, Converter={StaticResource HexToBrush}}"
                                                ToolTip="曲线颜色"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   Style="{StaticResource MacFileNameTextStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}"
                          ItemTemplateSelector="{StaticResource ChartCardTemplateSelector}"
                          Margin="6,8,6,16"
                          Padding="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
