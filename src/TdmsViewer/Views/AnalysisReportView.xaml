<UserControl x:Class="TdmsViewer.Views.AnalysisReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TdmsViewer.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="LineChartCardTemplate">
            <Border Margin="10">
                <controls:LineChartCard Model="{Binding}"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BarChartCardTemplate">
            <Border Margin="10">
                <controls:BarChartCard Model="{Binding}"/>
            </Border>
        </DataTemplate>
        <controls:ChartCardTemplateSelector x:Key="ChartCardTemplateSelector"
                                            LineChartTemplate="{StaticResource LineChartCardTemplate}"
                                            BarChartTemplate="{StaticResource BarChartCardTemplate}"/>
    </UserControl.Resources>
    <ScrollViewer x:Name="ReportScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  Padding="0,8,0,0"
                  PreviewMouseWheel="ReportScrollViewer_PreviewMouseWheel">
        <StackPanel>
            <Border Style="{StaticResource MacCardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Meta.Title, TargetNullValue='分析报告'}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MacSecondaryStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}"
                          ItemTemplateSelector="{StaticResource ChartCardTemplateSelector}"
                          Margin="6,8,6,16"
                          Padding="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
