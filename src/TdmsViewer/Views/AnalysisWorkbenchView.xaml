<UserControl x:Class="TdmsViewer.Views.AnalysisWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TdmsViewer.Converters"
             xmlns:vm="clr-namespace:TdmsViewer.ViewModels">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>
    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource MacCardStyle}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="分析工作台" Style="{StaticResource MacCaptionStyle}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>

                    <Border Padding="0,0,0,10"
                            Margin="0,0,0,12"
                            BorderBrush="{StaticResource MacSeparatorBrush}"
                            BorderThickness="0,0,0,0.5">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="图表叠加"
                                           Style="{StaticResource MacCaptionStyle}"
                                           VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource MacCheckBoxStyle}"
                                          Content="全选"
                                          IsChecked="{Binding IsAllOverlayChecked, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="勾选：当前通道下全部文件参与图表叠加"/>
                            </Grid>
                            <TextBlock Text="勾选需要叠加到图表中的文件"
                                       Style="{StaticResource MacSecondaryStyle}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <ScrollViewer MaxHeight="140"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OverlayFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TdmsFileListItem}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Style="{StaticResource MacCheckBoxStyle}"
                                                          IsChecked="{Binding IsVisibleOnPlot, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          ToolTip="参与图表叠加"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="24" Height="3"
                                                            CornerRadius="1.5"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"
                                                            Background="{Binding PlotColor, Converter={StaticResource HexToBrush}}"
                                                            ToolTip="曲线颜色"/>
                                                    <TextBlock Text="{Binding FileName}"
                                                               Style="{StaticResource MacFileNameTextStyle}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ChannelSummary}"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="运行分析"
                            Style="{StaticResource MacPrimaryButtonStyle}"
                            Command="{Binding RunAnalysisCommand}"
                            Margin="0,0,0,8"/>
                    <WrapPanel HorizontalAlignment="Stretch">
                        <Button Content="保存方案" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding SavePlanCommand}" Margin="0,0,8,8"/>
                        <Button Content="加载方案" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding LoadPlanCommand}" Margin="0,0,8,8"/>
                        <Button Content="恢复默认" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ResetPlanCommand}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MacSecondaryStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MacSecondaryStyle}" Margin="0,4,0,0"/>
                    <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,0,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding AvailableSteps}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,10" Margin="0,0,0,6" Background="#FFF9F9FB" CornerRadius="8">
                                <StackPanel>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Style="{StaticResource MacCheckBoxStyle}"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource MacSecondaryStyle}"
                                               Margin="24,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource MacCardStyle}" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Text="通道数据分析" FontSize="22" FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock Text="在左侧勾选分析步骤与叠加文件，然后点击运行分析生成 ScottPlot 报表。"
                           Style="{StaticResource MacSecondaryStyle}"
                           Margin="0,12,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Text="默认方案包含：时域波形、总声级曲线、平均频谱、三分之一倍频程。"
                           Style="{StaticResource MacSecondaryStyle}"
                           Margin="0,12,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
