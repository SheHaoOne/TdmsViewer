<UserControl x:Class="TdmsViewer.Views.AnalysisWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TdmsViewer.Converters"
             xmlns:vm="clr-namespace:TdmsViewer.ViewModels">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
        <Style x:Key="ParameterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MacSecondaryStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource MacCardStyle}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="分析工作台" Style="{StaticResource MacCaptionStyle}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ChannelSummary}"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="全局分析时段"
                               Style="{StaticResource MacCaptionStyle}"
                               Margin="0,12,0,6"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="起始 (s)" Style="{StaticResource MacSecondaryStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding GlobalStartTimeSec, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="结束 (s)" Style="{StaticResource MacSecondaryStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding GlobalEndTimeSec, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Text="结束时间填 0 表示分析到信号末尾。"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding GlobalTimeRangeSummary}"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="热力图色阶"
                               Style="{StaticResource MacCaptionStyle}"
                               Margin="0,12,0,6"/>
                    <CheckBox Style="{StaticResource MacCheckBoxStyle}"
                              Content="自动色阶"
                              IsChecked="{Binding UseAutoHeatmapColorRange, Mode=TwoWay}"
                              Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="下限" Style="{StaticResource MacSecondaryStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding HeatmapColorMinText, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding UseAutoHeatmapColorRange}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="上限" Style="{StaticResource MacSecondaryStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding HeatmapColorMaxText, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding UseAutoHeatmapColorRange}"/>
                    </Grid>
                    <TextBlock Text="手动色阶会作为热力图初始显示范围，报表中仍可单独调整。"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding GlobalHeatmapColorRangeSummary}"
                               Style="{StaticResource MacSecondaryStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="运行分析"
                            Style="{StaticResource MacPrimaryButtonStyle}"
                            Command="{Binding RunAnalysisCommand}"
                            Margin="0,0,0,8"/>
                    <WrapPanel HorizontalAlignment="Stretch">
                        <Button Content="保存方案" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding SavePlanCommand}" Margin="0,0,8,8"/>
                        <Button Content="加载方案" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding LoadPlanCommand}" Margin="0,0,8,8"/>
                        <Button Content="恢复默认" Style="{StaticResource MacToolbarButtonStyle}" Command="{Binding ResetPlanCommand}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MacSecondaryStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MacSecondaryStyle}" Margin="0,4,0,0"/>
                    <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,0,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding AvailableSteps}"
                         SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource MacFileListBoxItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AnalysisStepItem}">
                            <Grid ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Style="{StaticResource MacCheckBoxStyle}"
                                          VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource MacListPrimaryTextStyle}"/>
                                </CheckBox>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Description}"
                                           Style="{StaticResource MacListMetaTextStyle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource MacCardStyle}" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="算法参数"
                                   Style="{StaticResource MacCaptionStyle}"/>
                        <Button Grid.Column="1"
                                Content="恢复默认"
                                Style="{StaticResource MacToolbarButtonStyle}"
                                Padding="10,4"
                                Command="{Binding ResetStepParametersCommand}"
                                Visibility="{Binding CanEditParameters, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedStep.DisplayName, TargetNullValue='请选择一个分析步骤'}"
                               Style="{StaticResource MacBodyStyle}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SelectedStep.Description}"
                               Style="{StaticResource MacSecondaryStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="该步骤无可配置参数。"
                           Style="{StaticResource MacSecondaryStyle}"
                           Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding ShowNoParametersMessage, Converter={StaticResource BoolVis}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CanEditParameters, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding SelectedStep.Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AnalysisParameterItem}">
                                <Border Margin="0,0,0,14" Padding="0,0,0,14"
                                        BorderBrush="{StaticResource MacSeparatorBrush}"
                                        BorderThickness="0,0,0,0.5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource MacBodyStyle}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource MacSecondaryStyle}"
                                                   Margin="0,2,0,8"
                                                   TextWrapping="Wrap"/>

                                        <ComboBox ItemsSource="{Binding ChoiceOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedChoice, Mode=TwoWay}"
                                                  Margin="0,0,0,0"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolVis}}"/>

                                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,0"
                                                 Visibility="{Binding IsEditable, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
