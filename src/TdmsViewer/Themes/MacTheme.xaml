<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- macOS-inspired palette -->
    <Color x:Key="MacWindowBg">#FFF5F5F7</Color>
    <Color x:Key="MacCardBg">#FFFFFFFF</Color>
    <Color x:Key="MacSurfaceSecondary">#FFE8E8ED</Color>
    <Color x:Key="MacAccent">#FF007AFF</Color>
    <Color x:Key="MacAccentHover">#FF0056CC</Color>
    <Color x:Key="MacTextPrimary">#FF1D1D1F</Color>
    <Color x:Key="MacTextSecondary">#FF86868B</Color>
    <Color x:Key="MacSeparator">#FFD2D2D7</Color>
    <Color x:Key="MacDestructive">#FFFF3B30</Color>
    <Color x:Key="MacToolbarBg">#F2FFFFFF</Color>

    <SolidColorBrush x:Key="MacWindowBgBrush" Color="{StaticResource MacWindowBg}"/>
    <SolidColorBrush x:Key="MacCardBgBrush" Color="{StaticResource MacCardBg}"/>
    <SolidColorBrush x:Key="MacSurfaceSecondaryBrush" Color="{StaticResource MacSurfaceSecondary}"/>
    <SolidColorBrush x:Key="MacAccentBrush" Color="{StaticResource MacAccent}"/>
    <SolidColorBrush x:Key="MacTextPrimaryBrush" Color="{StaticResource MacTextPrimary}"/>
    <SolidColorBrush x:Key="MacTextSecondaryBrush" Color="{StaticResource MacTextSecondary}"/>
    <SolidColorBrush x:Key="MacSeparatorBrush" Color="{StaticResource MacSeparator}"/>
    <SolidColorBrush x:Key="MacDestructiveBrush" Color="{StaticResource MacDestructive}"/>

    <FontFamily x:Key="MacFont">Segoe UI, PingFang SC, Microsoft YaHei UI, sans-serif</FontFamily>

    <Style x:Key="MacCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MacBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MacSecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextSecondaryBrush}"/>
    </Style>

    <Style x:Key="MacCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MacCardBgBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderBrush" Value="{StaticResource MacSeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.08" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacToolbarButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource MacSurfaceSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFDCDCE0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFC7C7CC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MacToolbarButtonStyle}">
        <Setter Property="Background" Value="{StaticResource MacAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF0056CC"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF004499"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                CornerRadius="4"
                                Background="{StaticResource MacCardBgBrush}"
                                BorderBrush="{StaticResource MacSeparatorBrush}"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <Path x:Name="Mark"
                                  Data="M 2 5 L 6 9 L 12 2"
                                  Stroke="{StaticResource MacAccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  Margin="1"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource MacAccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MacAccentBrush}"/>
                            <Setter TargetName="Mark" Property="Stroke" Value="White"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MacAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacIconButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFF3B30"/>
                            <Setter Property="Foreground" Value="{StaticResource MacDestructiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FF3B30"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏列表（文件 / 通道）选中时前景色 -->
    <Style x:Key="MacListPrimaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MacBodyStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MacListMetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MacSecondaryStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="#E6FFFFFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MacFileNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MacListPrimaryTextStyle}">
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="MacFileMetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MacListMetaTextStyle}"/>

    <Style x:Key="MacFileNameButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource MacAccentBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MacFileListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MacAccentBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MacSurfaceSecondaryBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 与 MacFileListBoxItemStyle 相同，供通道列表复用 -->
    <Style x:Key="MacListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MacFileListBoxItemStyle}">
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="Background" Value="{StaticResource MacWindowBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource MacFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource MacSeparatorBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#08000000"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource MacSurfaceSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MacTextSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource MacSeparatorBrush}"/>
    </Style>

</ResourceDictionary>
